{
  "manifest_version": 3,
  "name": "Bill Prints Download",
  "version": "1.0.3",
  "description": "Download locality bill PDFs, save a CSV, and merge bills with pause and resume.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "offscreen", "unlimitedStorage"],
  "host_permissions": ["https://elgcd.punjab.gov.pk/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Open Bill Prints Download", "default_icon": {"16":"icons/icon16.png", "32":"icons/icon32.png"}},
  "icons": {"16":"icons/icon16.png", "32":"icons/icon32.png", "48":"icons/icon48.png", "128":"icons/icon128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
